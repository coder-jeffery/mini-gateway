# Shared Compose files for CI / local smoke (no external httpbin).
# shellcheck disable=SC2034
COMPOSE_FILE_LIST="docker-compose.yml:docker-compose.ci.yml"
COMPOSE_CI_FILES="${COMPOSE_CI_FILES:--f docker-compose.yml -f docker-compose.ci.yml}"
COMPOSE_CI_SERVICES="${COMPOSE_CI_SERVICES:-mock-upstream openresty}"