          "response": []
        }
      ]
    },
    {
      "name": "Admin API HMAC (POST /admin/gw/v1)",
      "item": [
        {
          "name": "hmac_test",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["signAdminHmac();"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('hmac verified', function () {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.ok).to.be.true;",
                  "  pm.expect(j.msg).to.eql('hmac verified');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ts\": {{hmac_ts}},\n  \"nonce\": \"{{hmac_nonce}}\",\n  \"sign\": \"{{hmac_sign}}\",\n  \"action\": \"hmac_test\"\n}"
            },
            "url": "{{admin_gw_v1_url}}"
          },
          "response": []
        },
