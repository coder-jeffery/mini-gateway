# memory (default) | redis | sqlite
GATEWAY_STORAGE=memory

# SQLite file (sqlite mode, persisted under ./data)
GATEWAY_SQLITE_PATH=/var/lib/gateway/gateway.db

# Redis (redis mode only)
GATEWAY_REDIS_HOST=redis
GATEWAY_REDIS_PORT=6379
# Docker 镜像（拉取失败时可改为可访问的 mirror 前缀，见 README）
REDIS_IMAGE=redis:7-alpine

DEFAULT_API_KEY=mini-key
DEFAULT_ADMIN_TOKEN=mini-token

# Business API auth: api_key (default) | bearer | both
GATEWAY_AUTH_MODE=api_key
# RS256: set issuer and/or JWKS; HS256 dev: set OAUTH2_JWT_SECRET instead
OAUTH2_ISSUER=
OAUTH2_JWKS_URI=
OAUTH2_AUDIENCE=
OAUTH2_REQUIRED_SCOPE=
OAUTH2_JWT_SECRET=
OAUTH2_CLOCK_SKEW_SEC=60
OAUTH2_JWKS_CACHE_TTL=300
OAUTH2_RATE_LIMIT_KEY=sub
OAUTH2_DEFAULT_LIMIT=
OAUTH2_DEFAULT_WINDOW=

# Published ports (docker compose openresty service)
GATEWAY_PORT=8080
UI_PORT=3000
GATEWAY_ADMIN_SECRET=admin-secret-2026
# UI 容器内访问网关（Docker DNS 服务名 openresty）
GATEWAY_ADMIN_URL=http://openresty:8080/admin/gw/v1
REDIS_PORT=6379
